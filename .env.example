# Copy this file to .env.local and fill it in. The server reads .env.local before .env; never commit either.

# MongoDB connection string. It must be a replica set (MongoDB Atlas is one), because publishing uses transactions.
MONGO_URI=
# A long random string that signs the session cookies. Keep it the same across restarts.
SESSION_SECRET=
# OpenWeatherMap API key for the article page's weather widget. Only the server uses it.
OPENWEATHER_API_KEY=
# The password node scripts/seed.js --apply gives the demo accounts (6 to 72 characters).
SEED_PASSWORD=

# Optional: remove the # to change the default.
# MONGO_DB_NAME=main_DB
PORT=3000
